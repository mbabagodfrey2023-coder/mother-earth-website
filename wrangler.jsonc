{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mother-earth-website",
  "account_id": "3ebcfcea1aa3545e90eb465b84facbc5",
  "main": "src/worker.js",
  "compatibility_date": "2026-05-26",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // Foundation-mode access controls must run before every static asset.
    // Otherwise exact asset matches bypass the Worker entirely.
    "run_worker_first": true
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "kv_namespaces": [
    {
      "binding": "COUNCIL_ARCHIVE",
      "id": "ed72059a838b4b8f8ccde26eb6122a85"
    },
    {
      // Run: npx wrangler kv namespace create POSTS_KV  — paste the returned id here
      "binding": "POSTS_KV",
      "id": "ef683fe0a8294704a0fc91faadcaab4d"
    }
  ],
  // Social auto-poster cron: 3×/day, spaced — 06:00, 09:00, 15:00 UTC
  // = 09:00, 12:00, 18:00 Nairobi. Changed from Mon/Wed/Fri 2026-07-11:
  // a video is produced daily, so 3×/week drained slower than it filled and
  // the queue backed up (19 posts). runSocialCycle posts 1 per fire, so this
  // clears ~2/day net until the backlog is gone, then self-regulates to the
  // 1 new post/day. Always-on Cloudflare cron (never sleeps) — the reliable
  // trigger the laptop-based node-cron could not be.
  "triggers": {
    "crons": ["0 6 * * *", "0 9 * * *", "0 15 * * *"]
  }
}
